# Line endings: shell scripts stay LF, Windows command files CRLF, binaries untouched.
* text=auto
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.dll binary
*.so binary
*.exe binary
*.cso binary
*.spv binary
*.png binary
*.ico binary
# Preserve the upstream CyUI port byte-for-byte (its SHA256 is recorded with the source).
app/vendor/cyui.py -text whitespace=cr-at-eol
app/cyui_modules/*.py -text
app/vendor/CYUI_LICENSE.txt -text

# Unified diff context whitespace is significant; keep source-patch bytes stable.
app/engine-patches/*.patch text eol=lf -whitespace

# Generated offline-reader hashes and pinned source notices require exact bytes.
app/help/** -text -whitespace
app/xbox_support/** -text whitespace=cr-at-eol
app/xbox_support/third_party/** -whitespace
docs/cydoc/vendor/*.tgz binary
docs/cydoc/vendor/CyDoc-LICENSE.txt -text
# Preserve the original reference snapshot's paragraph spacing.
modules/xbox-native/docs/HALO_REPORT.md whitespace=-blank-at-eof
