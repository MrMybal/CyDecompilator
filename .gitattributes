# Line endings: shell scripts stay LF, Windows command files CRLF, binaries untouched.
* text=auto
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.dll binary
*.so binary
*.exe binary
*.cso binary
*.spv binary
*.png binary
*.ico binary
# Preserve the upstream CyUI port byte-for-byte (its SHA256 is recorded with the source).
app/vendor/cyui.py -text whitespace=cr-at-eol

# Unified diff context whitespace is significant; keep source-patch bytes stable.
app/engine-patches/*.patch text eol=lf -whitespace
