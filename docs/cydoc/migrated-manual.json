  "diagrams": {
    "analysis": {
      "title": {
        "en": "From input to understanding",
        "fr": "De l’entrée à la compréhension"
      },
      "steps": [
        {
          "title": {
            "en": "Preserve input",
            "fr": "Conserver l’entrée"
          },
          "text": {
            "en": "Keep original bytes separate.",
            "fr": "Séparer les octets originaux."
          }
        },
        {
          "title": {
            "en": "Inspect format",
            "fr": "Examiner le format"
          },
          "text": {
            "en": "Confirm architecture and contents.",
            "fr": "Confirmer architecture et contenu."
          }
        },
        {
          "title": {
            "en": "Choose an engine",
            "fr": "Choisir un moteur"
          },
          "text": {
            "en": "Check its prerequisites.",
            "fr": "Vérifier ses prérequis."
          }
        },
        {
          "title": {
            "en": "Analyze",
            "fr": "Analyser"
          },
          "text": {
            "en": "Read progress and diagnostics.",
            "fr": "Lire progression et diagnostics."
          }
        },
        {
          "title": {
            "en": "Inspect code",
            "fr": "Examiner le code"
          },
          "text": {
            "en": "Compare functions and instructions.",
            "fr": "Comparer fonctions et instructions."
          }
        },
        {
          "title": {
            "en": "Record findings",
            "fr": "Conserver les conclusions"
          },
          "text": {
            "en": "Keep evidence and unknowns.",
            "fr": "Garder preuves et inconnues."
          }
        }
      ]
    },
    "reconstruction": {
      "title": {
        "en": "Reconstruct with evidence",
        "fr": "Reconstruire avec des preuves"
      },
      "steps": [
        {
          "title": {
            "en": "Original behavior",
            "fr": "Comportement original"
          },
          "text": {
            "en": "Define a repeatable scenario.",
            "fr": "Définir un scénario reproductible."
          }
        },
        {
          "title": {
            "en": "Editable project",
            "fr": "Projet modifiable"
          },
          "text": {
            "en": "Recover sources and resources.",
            "fr": "Récupérer sources et ressources."
          }
        },
        {
          "title": {
            "en": "Resolve blockers",
            "fr": "Résoudre les blocages"
          },
          "text": {
            "en": "Check ABI, entries and dependencies.",
            "fr": "Vérifier ABI, entrées et dépendances."
          }
        },
        {
          "title": {
            "en": "Build and repair",
            "fr": "Compiler et corriger"
          },
          "text": {
            "en": "Bound attempts; back up sources.",
            "fr": "Borner les essais ; sauvegarder."
          }
        },
        {
          "title": {
            "en": "Replay tests",
            "fr": "Rejouer les tests"
          },
          "text": {
            "en": "Run the intended assertions.",
            "fr": "Exécuter les assertions prévues."
          }
        },
        {
          "title": {
            "en": "Review result",
            "fr": "Examiner le résultat"
          },
          "text": {
            "en": "Separate builds from matching behavior.",
            "fr": "Distinguer compilation et comportement."
          }
        }
      ]
    },
    "patch": {
      "title": {
        "en": "Change one function",
        "fr": "Changer une fonction"
      },
      "steps": [
        {
          "title": {
            "en": "Select target",
            "fr": "Choisir la cible"
          },
          "text": {
            "en": "Confirm method and input identity.",
            "fr": "Confirmer méthode et identité."
          }
        },
        {
          "title": {
            "en": "Edit source",
            "fr": "Modifier les sources"
          },
          "text": {
            "en": "Preserve the external contract.",
            "fr": "Préserver le contrat externe."
          }
        },
        {
          "title": {
            "en": "Compile a plan",
            "fr": "Compiler un plan"
          },
          "text": {
            "en": "Check code and required bindings.",
            "fr": "Vérifier code et liaisons."
          }
        },
        {
          "title": {
            "en": "Review warnings",
            "fr": "Lire les avertissements"
          },
          "text": {
            "en": "Inspect size, IL or relocations.",
            "fr": "Examiner taille, IL ou relocations."
          }
        },
        {
          "title": {
            "en": "Create a copy",
            "fr": "Créer une copie"
          },
          "text": {
            "en": "Retain original and receipt.",
            "fr": "Conserver original et reçu."
          }
        },
        {
          "title": {
            "en": "Validate behavior",
            "fr": "Valider le comportement"
          },
          "text": {
            "en": "Test the requested change.",
            "fr": "Tester le changement demandé."
          }
        }
      ]
    },
    "evidence": {
      "title": {
        "en": "From scenario to conclusion",
        "fr": "Du scénario à la conclusion"
      },
      "steps": [
        {
          "title": {
            "en": "Choose versions",
            "fr": "Choisir les versions"
          },
          "text": {
            "en": "Record identities and prerequisites.",
            "fr": "Consigner identités et prérequis."
          }
        },
        {
          "title": {
            "en": "Define actions",
            "fr": "Définir les actions"
          },
          "text": {
            "en": "Use the same inputs and checks.",
            "fr": "Utiliser mêmes entrées et contrôles."
          }
        },
        {
          "title": {
            "en": "Run separately",
            "fr": "Exécuter séparément"
          },
          "text": {
            "en": "Bound time and process ownership.",
            "fr": "Borner durée et processus."
          }
        },
        {
          "title": {
            "en": "Capture evidence",
            "fr": "Capturer les preuves"
          },
          "text": {
            "en": "Outputs, files, screens, network.",
            "fr": "Sorties, fichiers, écrans, réseau."
          }
        },
        {
          "title": {
            "en": "Compare",
            "fr": "Comparer"
          },
          "text": {
            "en": "Inspect differences and missing data.",
            "fr": "Examiner écarts et données absentes."
          }
        },
        {
          "title": {
            "en": "Scope the claim",
            "fr": "Préciser la conclusion"
          },
          "text": {
            "en": "Only observed checks are established.",
            "fr": "Seuls les contrôles observés sont établis."
          }
        }
      ]
    },
    "assistant": {
      "title": {
        "en": "An autonomous task still needs proof",
        "fr": "Une tâche autonome exige des preuves"
      },
      "steps": [
        {
          "title": {
            "en": "Define the task",
            "fr": "Définir la tâche"
          },
          "text": {
            "en": "Specify scope and expected behavior.",
            "fr": "Préciser périmètre et résultat."
          }
        },
        {
          "title": {
            "en": "Inspect evidence",
            "fr": "Examiner les preuves"
          },
          "text": {
            "en": "Discover tools and prerequisites.",
            "fr": "Découvrir outils et prérequis."
          }
        },
        {
          "title": {
            "en": "Plan bounded work",
            "fr": "Borner le travail"
          },
          "text": {
            "en": "Keep steps and retries finite.",
            "fr": "Limiter étapes et tentatives."
          }
        },
        {
          "title": {
            "en": "Back up and edit",
            "fr": "Sauvegarder et modifier"
          },
          "text": {
            "en": "Check source revisions and history.",
            "fr": "Vérifier révisions et historique."
          }
        },
        {
          "title": {
            "en": "Build and verify",
            "fr": "Compiler et vérifier"
          },
          "text": {
            "en": "Require actual recorded results.",
            "fr": "Exiger des résultats enregistrés."
          }
        },
        {
          "title": {
            "en": "Report or resume",
            "fr": "Rapporter ou reprendre"
          },
          "text": {
            "en": "Retain checkpoints and unknowns.",
            "fr": "Conserver reprise et inconnues."
          }
        }
      ]
    },
    "porting": {
      "title": {
        "en": "Console input to a tested desktop output",
        "fr": "De l’entrée console à une sortie testée"
      },
      "steps": [
        {
          "title": {
            "en": "Preserve resources",
            "fr": "Préserver les ressources"
          },
          "text": {
            "en": "Inspect complete, readable input.",
            "fr": "Examiner une entrée complète lisible."
          }
        },
        {
          "title": {
            "en": "Select backend",
            "fr": "Choisir le backend"
          },
          "text": {
            "en": "Install the optional compatible tool.",
            "fr": "Installer l’outil optionnel compatible."
          }
        },
        {
          "title": {
            "en": "Convert or generate",
            "fr": "Convertir ou générer"
