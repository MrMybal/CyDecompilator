#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { float data[]; } src;
layout(std430, binding = 1) writeonly buffer Out { float data[]; } dst;
shared float tile[66];
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint l = gl_LocalInvocationID.x;
    tile[l + 1] = src.data[i];
    if (l == 0u) tile[0] = src.data[max(int(i) - 1, 0)];
    barrier();
    float sum = 0.0;
    for (int k = 0; k < 3; k++) sum += tile[l + uint(k)];
    dst.data[i] = sum / 3.0;
}
