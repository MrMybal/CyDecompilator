+            key.push_back(bank.size());
+            key.insert(key.end(), bank.begin(), bank.end());
+        }
+    }
+
+    void Restore(QueueState& state) const {
+        const std::array<Registers*, 3> registers{&state.shader, &state.context, &state.userConfig};
+        for (std::size_t index = 0; index < banks.size(); ++index) {
+            for (const auto word : banks[index]) registers[index]->insert_or_assign(static_cast<std::uint32_t>(word >> 32u), static_cast<std::uint32_t>(word));
