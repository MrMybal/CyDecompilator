+struct NativeGraphicsAbiState {
+    std::array<std::vector<std::uint64_t>, 3> banks;
+
+    template<typename TValue, typename TVisit>
+    static void Visit(const ShaderSnapshot& snapshot, const TValue* pointer, std::size_t count, TVisit&& visit) {
