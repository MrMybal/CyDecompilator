+template<typename TValue, typename TWord>
+class NativePreparedLookup {
+    struct Entry {
+        std::weak_ptr<TValue> value;
+        std::weak_ptr<const void> scope;
+        std::vector<TWord> key;
+    };
+    static constexpr std::size_t Sets = 32;
+    static constexpr std::size_t Ways = 4;
+    std::array<Entry, Sets * Ways> entries;
+    std::array<std::uint8_t, Sets> next{};
+
+    std::size_t bucket(std::span<const TWord> key, const std::shared_ptr<const void>& scope) const {
+        std::uint64_t hash = 0xcbf29ce484222325ull ^ reinterpret_cast<std::uintptr_t>(scope.get());
+        for (const auto word : key) hash = (hash ^ word) * 0x100000001b3ull;
+        return static_cast<std::size_t>((hash ^ (hash >> 32u)) & (Sets - 1u));
+    }
+
+public:
+    std::shared_ptr<TValue> Find(std::span<const TWord> key, const std::shared_ptr<const void>& scope = {}) const {
+        const auto base = bucket(key, scope) * Ways;
+        for (std::size_t way = 0; way < Ways; ++way) {
+            const auto& entry = entries[base + way];
+            if (!std::ranges::equal(entry.key, key) || entry.scope.lock() != scope) continue;
+            if (auto value = entry.value.lock()) return value;
+        }
+        return {};
+    }
+
+    void Store(std::span<const TWord> key, const std::shared_ptr<TValue>& value, const std::shared_ptr<const void>& scope = {}) {
+        if (key.size() > 4096) return;
+        const auto set = bucket(key, scope);
+        auto& entry = entries[set * Ways + next[set]];
+        next[set] = static_cast<std::uint8_t>((next[set] + 1u) % Ways);
+        entry.key.assign(key.begin(), key.end());
+        entry.scope = scope;
+        entry.value = value;
+    }
+};
