diff --git a/core/libs/prx/libSceAgcDriver/tests/execution/DepthCopy.cpp b/core/libs/prx/libSceAgcDriver/tests/execution/DepthCopy.cpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/execution/DepthCopy.cpp
@@ -0,0 +1,118 @@
+#include "prx/libSceAgcDriver/Execution/include/VulkanDevice.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/DepthCopy.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/Draw.hpp"
+#include "DepthFastClearHarness.hpp"
+#include "VulkanTestDevice.hpp"
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+
+using AgcDriver::Graphics::Require;
+using ShaderRecompiler::ShaderStage;
+constexpr std::uint32_t Width = 64u;
+constexpr std::uint32_t Height = 32u;
+alignas(4096) std::array<std::byte, 65536> Depth{};
+alignas(4096) std::array<float, Width * Height> ProducerColor{};
+alignas(4096) std::array<float, Width * Height> Copied{};
+using Vertex = std::array<float, 4>;
+constexpr std::array<Vertex, 3> Producer{{{-1, -1, 0.25f, 1}, {3, -1, 1.25f, 1}, {-1, 3, 0.25f, 1}}};
+constexpr std::array<Vertex, 3> Full{{{-1, -1, 0.5f, 1}, {3, -1, 0.5f, 1}, {-1, 3, 0.5f, 1}}};
+constexpr std::array<Vertex, 6> Half{{{-1, -1, 0.5f, 1}, {0, -1, 0.5f, 1}, {-1, 1, 0.5f, 1}, {0, -1, 0.5f, 1}, {0, 1, 0.5f, 1}, {-1, 1, 0.5f, 1}}};
+constexpr std::array<Vertex, 3> Triangle{{{-1, 1, 0.5f, 1}, {1, 1, 0.5f, 1}, {-1, -1, 0.5f, 1}}};
+
+ShaderRecompiler::RecompileResult CompileVertex(AgcDriver::VulkanDevice& device, std::span<const Vertex> vertices) {
+    const auto descriptor = DepthFastClearHarness::BufferDescriptor(vertices.data(), 16u, static_cast<std::uint32_t>(vertices.size()));
+    const std::array<ShaderRecompiler::MemoryRegion, 1> memory{{{reinterpret_cast<std::uintptr_t>(DepthFastClearHarness::VertexCode.data()), std::as_bytes(std::span(DepthFastClearHarness::VertexCode))}}};
+    ShaderRecompiler::RecompileRequest request{
+        {ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(DepthFastClearHarness::VertexCode.data()), DepthFastClearHarness::VertexCode, 0, {}},
+        {32, 0, descriptor, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, memory},
+        device.Target(), {0, 0, 0, 64}
+    };
+    request.useCache = false;
+    return ShaderRecompiler::Recompile(request);
+}
+
+AgcDriver::Graphics::State State(float* color) {
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, 32u, 32u, std::nullopt, std::nullopt};
+    state.color = {reinterpret_cast<std::uintptr_t>(color), {Width, Height}, VK_FORMAT_R32_SFLOAT, Width * Height * 4u, 0xe4u};
+    state.colors = {state.color};
+    state.hasColorTarget = true;
+    state.renderExtent = {Width, Height};
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(Height), static_cast<float>(Width), -static_cast<float>(Height), 0, 1};
+    state.scissor = {{0, 0}, {Width, Height}};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    state.blend.colorWriteMask = VK_COLOR_COMPONENT_R_BIT;
+    state.blends = {state.blend};
+    return state;
+}
+
+void Draw(AgcDriver::VulkanDevice& device, const AgcDriver::Graphics::State& state, std::span<const Vertex> vertices, const ShaderRecompiler::RecompileResult& pixel, bool rectangle = false) {
+    auto vertex = CompileVertex(device, vertices);
+    std::vector<AgcDriver::Graphics::CompiledShader> stages{
+        {ShaderStage::Vertex, &vertex, 0},
+        {ShaderStage::Fragment, &pixel, pixel.pushConstants.empty() ? 0u : PixelPushOffset(static_cast<std::uint32_t>(vertex.pushConstants.size()), device.Target())}
+    };
+    std::optional<ShaderRecompiler::RectListShaders> rect;
+    if (rectangle) {
+        rect = ShaderRecompiler::BuildRectListShaders(vertex, pixel, device.Target());
+        stages.insert(stages.begin() + 1, {{ShaderStage::TessellationControl, &rect->control, 0}, {ShaderStage::TessellationEvaluation, &rect->evaluation, 0}});
+    }
+    const AgcDriver::Pm4::DrawParameters draw{0, static_cast<std::uint32_t>(vertices.size()), 0, 1, 0, false};
+    device.Draw(state, draw, stages);
+    device.WaitIdle();
+}
+
+}
+
+int main() {
+    try {
+        const auto device = OpenVulkanTestDevice();
+        if (!device) return VulkanTestSkipped;
+        const auto producerShader = DepthFastClearHarness::Compile(*device);
+        auto producer = State(ProducerColor.data());
+        producer.depth = AgcDriver::Graphics::DepthTarget{reinterpret_cast<std::uintptr_t>(Depth.data()), 0, {Width, Height}, VK_FORMAT_D32_SFLOAT, 1, 0};
+        producer.depthTest = true;
+        producer.depthWrite = true;
+        producer.depthCompare = VK_COMPARE_OP_ALWAYS;
+        Draw(*device, producer, Producer, producerShader.pixel);
+        const auto fragment = AgcDriver::Graphics::DepthCopyFragment(*producer.depth);
+        for (std::uint32_t test = 0; test < 7u; ++test) {
+            constexpr float Sentinel = -7.25f;
+            Copied.fill(Sentinel);
+            auto state = State(Copied.data());
+            if (test == 2u || test == 6u) state.scissor = {{8, 5}, {32, 18}};
+            if (test == 4u) state.cullMode = VK_CULL_MODE_FRONT_AND_BACK;
+            const std::span<const Vertex> vertices = test == 1u || test == 2u ? std::span<const Vertex>(Half) : test == 3u ? std::span<const Vertex>(Triangle) : std::span<const Vertex>(Full);
+            if (test >= 5u) {
+                state.rectList = true;
+                state.topology = VK_PRIMITIVE_TOPOLOGY_PATCH_LIST;
+            }
+            Draw(*device, state, test >= 5u ? std::span<const Vertex>(Half).first(3) : vertices, fragment, test >= 5u);
+            for (std::uint32_t y = 0; y < Height; ++y) {
+                for (std::uint32_t x = 0; x < Width; ++x) {
+                    bool covered = test == 0u || ((test <= 2u || test >= 5u) && x < Width / 2u) || (test == 3u && (x + 0.5f) / Width + (y + 0.5f) / Height < 1.0f);
+                    if (test == 2u || test == 6u) covered = covered && x >= 8u && x < 40u && y >= 5u && y < 23u;
+                    const float expected = covered ? 0.25f + 0.5f * (x + 0.5f) / Width : Sentinel;
+                    const auto actual = Copied[y * Width + x];
+                    if (std::abs(actual - expected) > 0.00001f) {
+                        char text[256];
+                        std::snprintf(text, sizeof(text), "depth copy case %u pixel (%u,%u): got %.9g, expected %.9g", test, x, y, actual, expected);
+                        throw std::runtime_error(text);
+                    }
+                }
+            }
+        }
+        std::puts("Depth copy GPU values, geometry, scissor and culling passed: 14336 pixels checked");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
