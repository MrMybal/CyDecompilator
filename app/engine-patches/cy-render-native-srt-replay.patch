+bool Recorder::rotateDrawSnapshot(std::map<DrawSnapshotKey, DrawSnapshot>::iterator entry, std::uint64_t generation) {
+    static const bool enabled = std::getenv("APS5_NO_DRAW_SNAPSHOT_ROTATION") == nullptr;
+    if (!enabled) return false;
+    const auto address = std::get<0>(entry->first);
+    const auto bytes = std::get<2>(entry->first);
+    const auto registry = GuestAllocations::GuestAllocationsGeneration_nid_postfix();
+    const auto source = storageSnapshotSources.find(entry->second.buffer.get());
+    if (source == storageSnapshotSources.end() || source->second != entry->first) return false;
+    for (auto retired = retiredDrawSnapshots.begin(); retired != retiredDrawSnapshots.end(); ++retired) {
+        auto& candidate = retired->snapshot;
+        if (retired->key != entry->first || candidate.registryGeneration != registry || candidate.buffer.use_count() != 1 || (candidate.resident != nullptr && candidate.resident.use_count() != 1)) continue;
+        if (!refreshDrawSnapshot(candidate, address, bytes)) continue;
+        auto indexed = storageSnapshotSources.extract(entry->second.buffer.get());
+        Require(!indexed.empty(), "rotating snapshot lost its storage source index");
+        indexed.key() = candidate.buffer.get();
+        const auto recent = entry->second.recent;
+        std::swap(entry->second, candidate);
+        entry->second.recent = recent;
+        candidate.recent = {};
+        entry->second.generation = generation;
+        storageSnapshotSources.insert(std::move(indexed));
+        retiredDrawSnapshots.splice(retiredDrawSnapshots.end(), retiredDrawSnapshots, retired);
+        ++residentSnapshotStats.rotations;
+        return true;
+    }
+    return false;
