+void Recorder::retireDrawSnapshot(std::map<DrawSnapshotKey, DrawSnapshot>::iterator entry) {
+    static const bool enabled = std::getenv("APS5_NO_DRAW_SNAPSHOT_ROTATION") == nullptr;
+    const auto bytes = std::get<2>(entry->first);
+    if (!enabled || std::get<1>(entry->first) != SnapshotUse::Storage || bytes > DrawSnapshotBudget / 4) {
+        eraseDrawSnapshot(entry);
+        return;
+    }
+    while (!retiredDrawSnapshots.empty() && (retiredDrawSnapshotBytes + bytes > DrawSnapshotBudget / 4 || retiredDrawSnapshots.size() >= RetiredDrawSnapshotEntries)) eraseRetiredDrawSnapshot(retiredDrawSnapshots.begin());
+    auto retired = retiredDrawSnapshots.emplace(retiredDrawSnapshots.end(), RetiredDrawSnapshot{entry->first, {}});
+    auto& pool = drawSnapshotPools[SnapshotPool(SnapshotUse::Storage)];
+    pool.bytes -= bytes;
+    pool.recency.erase(entry->second.recent);
+    const auto indexed = storageSnapshotSources.find(entry->second.buffer.get());
+    if (indexed != storageSnapshotSources.end() && indexed->second == entry->first) storageSnapshotSources.erase(indexed);
+    retired->snapshot = std::move(entry->second);
+    retired->snapshot.recent = {};
+    drawSnapshots.erase(entry);
+    retiredDrawSnapshotBytes += bytes;
