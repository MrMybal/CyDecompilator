+void Recorder::ResidentDrawSnapshots(std::span<const std::shared_ptr<Buffer>> sources, std::span<std::shared_ptr<DeviceBuffer>> residents) {
+    Require(sources.size() == residents.size(), "resident snapshot output count differs from its sources");
+    std::fill(residents.begin(), residents.end(), nullptr);
+    static const bool enabled = std::getenv("APS5_NO_RESIDENT_DRAW_SNAPSHOTS") == nullptr;
+    if (!enabled) return;
