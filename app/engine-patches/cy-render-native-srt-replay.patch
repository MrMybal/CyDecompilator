+void CheckFinePageMasks() {
+    constexpr std::size_t size = 3 * Block;
+    auto* memory = static_cast<volatile std::uint8_t*>(AllocateWatched(size));
+    const auto base = reinterpret_cast<std::uint64_t>(memory);
+    std::memset(const_cast<std::uint8_t*>(memory), 0x51, size);
+    auto before = CollectWritesUncached(base, size);
+    std::array<std::uint16_t, 3> masks{};
+    Require(ChangedPageMasks(base, size, before, masks) && masks == std::array<std::uint16_t, 3>{0, 0, 0}, "settled page masks are dirty");
+    memory[7] = 0x62;
+    memory[15 * 4096 + 3] = 0x63;
+    memory[Block + 4096] = 0x64;
+    CollectWritesUncached(base, size);
+    Require(ChangedPageMasks(base, size, before, masks) && masks == std::array<std::uint16_t, 3>{0x8001, 2, 0}, "CPU page masks lost a write or dirtied a neighboring page");
+    before = TrackerGeneration();
+    MarkWritten(base + Block - 2, 4);
+    Require(ChangedPageMasks(base, size, before, masks) && masks == std::array<std::uint16_t, 3>{0x8000, 1, 0}, "a driver store crossing a block lost a page");
+    std::uint32_t state = 0x841f21u;
+    for (unsigned round = 0; round < 48; ++round) {
+        before = TrackerGeneration();
+        for (unsigned store = 0; store < 7; ++store) {
+            state = state * 1664525u + 1013904223u;
+            const auto offset = state % (size - 4);
+            if ((store & 1u) == 0) memory[offset] = static_cast<std::uint8_t>(round + store);
+            else MarkWritten(base + offset, 4);
+        }
+        CollectWritesUncached(base, size);
+        Require(ChangedPageMasks(base, size, before, masks), "randomized page masks refused watched memory");
+        for (std::size_t page = 0; page < size / 4096; ++page) {
+            const bool changed = (masks[page / 16] & (std::uint16_t{1} << (page % 16))) != 0;
+            Require(changed == !UnchangedSince(base + page * 4096, 4096, before), "page masks differ from the existing range proof");
+        }
+    }
+    before = TrackerGeneration();
+    for (unsigned store = 0; store < 7; ++store) MarkWritten(base + 2 * Block + store * 8, 4);
+    Require(ChangedPageMasks(base, size, before, masks) && masks[2] == 0xffff, "dropped driver history did not invalidate the entire block");
+    Require(ChangedPageMasks(base + Block - 1, 2, before, std::span(masks).first(2)), "unaligned page-mask query crossing a block failed");
+    Require(!ChangedPageMasks(base, size, before, std::span(masks).first(1)) && masks[0] == 0xffff, "short page-mask output offered incomplete clean evidence");
+    Require(!ChangedPageMasks(base, size, 0, masks) && masks[0] == 0xffff, "unknown generation offered clean pages");
+    Require(!ChangedPageMasks(std::numeric_limits<std::uint64_t>::max() - 1, 4, before, masks) && masks[0] == 0xffff, "overflowing page range offered clean pages");
+    Unwatch(base, Block);
+    Require(!ChangedPageMasks(base, size, before, masks) && masks == std::array<std::uint16_t, 3>{0xffff, 0xffff, 0xffff}, "unwatched memory offered page proofs");
+    std::puts("native fine page masks and conservative fallbacks passed");
+}
