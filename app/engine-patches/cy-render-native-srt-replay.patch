+void RetirementReleasesTheQueueLock() {
+    struct State {
+        std::atomic<bool> start{false};
+        std::atomic<bool> entered{false};
+        std::atomic<bool> release{false};
+    } state;
+    struct Retired {
+        State& state;
+        explicit Retired(State& state) : state(state) {}
+        ~Retired() {
+            static_cast<void>(DrawPipeline::QueuedItems());
+            static_cast<void>(DrawPipeline::Queue0().Overlaps(1, 4));
+            state.entered.store(true);
+            while (!state.release.load()) std::this_thread::yield();
+        }
+    };
+    auto captured = std::make_shared<Retired>(state);
+    DrawPipeline::Queue0().Enqueue([captured, &state] {
+        while (!state.start.load()) std::this_thread::yield();
+    }, {});
+    captured.reset();
+    state.start.store(true);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+    while (!state.entered.load() && std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
+    if (!state.entered.load()) {
+        std::fputs("completed draw destruction still holds the queue lock\n", stderr);
+        std::_Exit(1);
+    }
+    Require(DrawPipeline::Queue0().Busy(), "the pipeline must remain busy until completed resources are released");
+    auto drain = std::async(std::launch::async, [] { DrawPipeline::Queue0().Drain(DrawPipeline::DrainReason::Submission); });
+    const auto early = drain.wait_for(std::chrono::milliseconds(25));
+    state.release.store(true);
+    Require(early == std::future_status::timeout, "drain returned while completed resources were still retained");
+    Require(drain.wait_for(std::chrono::seconds(3)) == std::future_status::ready, "drain did not resume after completed resource release");
+    drain.get();
+    std::puts("native draw retirement lock and lifetime passed");
+}
