+void LargerClassesAndForeignBlocks() {
+    constexpr std::size_t sizes[]{1023, 1024, 1025, 1535, 2047, 2048, 2049, 4095, 4096, 4097, 8191, 8192, 8193, 16383, 16384, 16385, 32767, 32768, 32769, 65535, 65536, 65537, 131072};
