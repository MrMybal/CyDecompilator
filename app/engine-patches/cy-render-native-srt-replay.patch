+    std::vector<std::shared_ptr<DispatchVariant>> recipeStages;
+
+    void Reset() noexcept {
+        userPatches.clear();
+        for (auto& program : writablePrograms) {
+            program.snapshot.reset();
+            program.tailContinuation.reset();
+            program.userData.clear();
+            program.binary = {};
+            program.memory = {};
+        }
+        memory.clear();
+        linked.clear();
+        for (auto& info : vertexInfos) info.reset();
+        for (auto& reads : decodeReads) reads.clear();
+        results.clear();
+        compiledStages.clear();
+        stages.clear();
+        programResults.clear();
+        for (auto& capture : stageCaptures) {
+            capture.compiled.reset();
+            capture.capture.reset();
+            capture.regions.clear();
+            capture.supplied.clear();
+            capture.forgetSerial = 0;
+            capture.pushOffset = 0;
+            capture.userDataUse.asBase = capture.userDataUse.asValue = 0;
+            capture.userDataUse.reads.clear();
+        }
+        for (auto& variant : matched) variant.reset();
+        for (auto& regions : matchedRegions) regions.clear();
+        for (auto& variant : fresh) variant.reset();
+        for (auto& candidates : dataCandidates) candidates.clear();
+        for (auto& hit : stageData) {
+            hit.compiled.reset();
+            hit.words.clear();
+        }
+        recompiled.clear();
+        reused.clear();
+        pushOffsets.clear();
+        resultIndex.clear();
+        snapshots.clear();
+        recipeStages.clear();
+        shaderMemory.reset();
+    }
+
+    std::size_t RetainedBytes() const {
+        std::size_t bytes = 0;
+        const auto add = [&](const auto& values) { bytes += values.capacity() * sizeof(typename std::decay_t<decltype(values)>::value_type); };
+        add(userPatches); add(writablePrograms); add(memory); add(linked); add(vertexInfos); add(decodeReads);
+        add(results); add(compiledStages); add(stages); add(programResults); add(stageCaptures); add(matched);
+        add(matchedRegions); add(fresh); add(dataCandidates); add(stageData); add(pushOffsets); add(resultIndex);
+        add(snapshots); add(recipeStages);
+        bytes += (recompiled.capacity() + reused.capacity() + 7u) / 8u;
+        for (const auto& program : writablePrograms) add(program.userData);
+        for (const auto& reads : decodeReads) add(reads);
+        for (const auto& capture : stageCaptures) { add(capture.regions); add(capture.supplied); add(capture.userDataUse.reads); }
+        for (const auto& regions : matchedRegions) add(regions);
+        for (const auto& candidates : dataCandidates) add(candidates);
+        for (const auto& hit : stageData) add(hit.words);
+        return bytes;
+    }
+};
+
+std::shared_ptr<NativeDrawScratch> AcquireNativeDrawScratch() {
+    struct Pool {
+        std::mutex mutex;
+        std::vector<std::unique_ptr<NativeDrawScratch>> free;
+        Pool() { free.reserve(64); }
+    };
+    struct PoolStorage {};
+    auto& slot = HostThreadLocal<std::shared_ptr<Pool>, PoolStorage>();
+    if (slot == nullptr) slot = std::make_shared<Pool>();
+    auto pool = slot;
+    std::unique_ptr<NativeDrawScratch> owned;
+    static const bool enabled = std::getenv("APS5_NO_NATIVE_DRAW_SCRATCH") == nullptr;
+    if (enabled) {
+        std::lock_guard lock(pool->mutex);
+        if (!pool->free.empty()) {
+            owned = std::move(pool->free.back());
+            pool->free.pop_back();
+            static const bool verify = std::getenv("APS5_CHECK_NATIVE_ABI_KEYS") != nullptr;
+            if (verify) {
+                static std::atomic<bool> checked{false};
+                if (!checked.exchange(true, std::memory_order_relaxed)) std::fprintf(stderr, "native draw scratch reuse verified\n");
+            }
+        }
+    }
+    if (owned == nullptr) owned = std::make_unique<NativeDrawScratch>();
+    return {owned.release(), [pool](NativeDrawScratch* pointer) noexcept {
+        std::unique_ptr<NativeDrawScratch> returned(pointer);
+        returned->Reset();
+        if (!enabled || returned->RetainedBytes() > (std::size_t{512} << 10u)) return;
+        try {
+            std::lock_guard lock(pool->mutex);
+            if (pool->free.size() < 64) pool->free.push_back(std::move(returned));
+        } catch (...) {}
+    }};
+}
