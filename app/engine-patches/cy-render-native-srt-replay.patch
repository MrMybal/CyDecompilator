+void SnapshotCompareSpans(std::span<const std::byte> held, std::uint64_t address, std::size_t bytes, std::uint64_t generation, std::vector<CompareSpan>& spans) {
+    constexpr std::uint64_t block = 65536;
+    constexpr std::uint64_t pageBytes = 4096;
+    const auto aligned = address / block * block;
+    const auto end = address + bytes;
+    const auto count = static_cast<std::size_t>((end - 1) / block - address / block + 1);
+    struct Scratch {
+        std::vector<std::uint64_t> generations;
+        std::vector<std::uint8_t> changed;
+        std::vector<std::uint16_t> masks;
+    };
+    auto& scratch = HostThreadLocal<Scratch, Scratch>();
+    scratch.masks.assign(count, 0xffff);
+    if (FineDrawUpdates()) GuestMemory::ChangedPageMasks(address, bytes, generation, scratch.masks);
+    else {
+        scratch.generations.assign(count, generation);
+        scratch.changed.assign(count, GuestMemory::BlockWritten);
+        GuestMemory::ChangedBlocks(address, bytes, scratch.generations, scratch.changed);
+        for (std::size_t index = 0; index < count; ++index) scratch.masks[index] = scratch.changed[index] == GuestMemory::BlockUnchanged ? 0 : 0xffff;
+    }
+    spans.clear();
+    for (std::size_t index = 0; index < count; ++index) {
+        const auto mask = scratch.masks[index];
+        for (std::size_t page = 0; page < block / pageBytes; ++page) {
+            if ((mask & (std::uint16_t{1} << page)) == 0) continue;
+            const auto pageBegin = aligned + index * block + page * pageBytes;
+            const auto from = std::max(address, pageBegin);
+            const auto to = std::min(end, pageBegin + pageBytes);
+            if (from >= to) continue;
+            const auto* first = held.data() + (from - address);
+            const auto length = static_cast<std::size_t>(to - from);
+            if (!spans.empty() && static_cast<const std::byte*>(spans.back().first) + spans.back().bytes == first && spans.back().bytes + length <= block) spans.back().bytes += length;
+            else spans.push_back({first, reinterpret_cast<const void*>(from), length});
+        }
+    }
+}
+
+void BoundSnapshotRanges(std::vector<std::pair<std::size_t, std::size_t>>& ranges) {
+    constexpr std::size_t maximum = 128;
+    if (ranges.size() <= maximum) return;
+    const auto stride = (ranges.size() + maximum - 1) / maximum;
+    std::size_t count = 0;
+    for (std::size_t first = 0; first < ranges.size(); first += stride) {
+        const auto& last = ranges[std::min(first + stride, ranges.size()) - 1];
+        ranges[count++] = {ranges[first].first, last.first + last.second - ranges[first].first};
+    }
+    ranges.resize(count);
+}
