+            if (indexed == storageSnapshotSources.end()) continue;
+            const auto found = drawSnapshots.find(indexed->second);
+            if (found == drawSnapshots.end() || found->second.buffer != source) continue;
+            auto& snapshot = found->second;
+            const auto bytes = std::get<2>(found->first);
+            if (bytes < 65536 || bytes % 4 != 0 || bytes > DrawResidentBudget || source->Bytes().size() != bytes) continue;
