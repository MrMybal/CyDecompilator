+                auto* block = static_cast<unsigned char*>(::operator new(size));
+                FillAndVerify(block, size, static_cast<unsigned char>(round));
+                blocks.push_back(block);
+            }
+        }
+        std::size_t at = 0;
+        for (const auto size : sizes) {
+            for (int held = 0; held < 8; ++held) {
+                if ((held & 1) == 0) ::operator delete(blocks[at++], size);
+                else ::operator delete(blocks[at++]);
+            }
+        }
+    }
+#ifdef _WIN32
+    for (const auto size : sizes) {
+        auto* foreign = std::malloc(size);
+        Check(foreign != nullptr, "a foreign block was allocated");
+        if (foreign != nullptr) ::operator delete(foreign, size);
+        for (std::size_t requested = 1024; requested <= 65536; requested *= 2) {
+            auto* block = static_cast<unsigned char*>(::operator new(requested));
+            Check(_msize(block) >= requested, "a reused foreign block is large enough for its class");
+            FillAndVerify(block, requested, 17);
+            ::operator delete(block);
+        }
+    }
+#endif
+    std::vector<void*> transferred(256);
+    std::thread maker([&] {
+        for (std::size_t i = 0; i < transferred.size(); ++i) {
+            const auto size = sizes[i % std::size(sizes)];
+            transferred[i] = ::operator new(size);
+            std::memset(transferred[i], static_cast<int>(i & 255), size);
+        }
+    });
+    maker.join();
+    std::thread freer([&] {
+        for (std::size_t i = 0; i < transferred.size(); ++i) {
+            const auto size = sizes[i % std::size(sizes)];
+            const auto* bytes = static_cast<const unsigned char*>(transferred[i]);
+            Check(bytes[0] == (i & 255) && bytes[size - 1] == (i & 255), "large cross-thread buffers retain their endpoints");
+            ::operator delete(transferred[i], size);
+        }
+    });
+    freer.join();
+    std::puts("native host allocator larger classes passed");
