+        const auto found = std::lower_bound(bank.begin(), bank.end(), offset);
+        if (found != bank.end() && (*found >> 32u) == reg.offset) *found = offset | reg.value;
+        else bank.insert(found, offset | reg.value);
+    }
+
+    void Apply(const ShaderSnapshot& snapshot) {
+        const auto header = ReadHeader(snapshot);
+        Visit(snapshot, header.sh_registers, header.num_sh_registers, [&](ShaderRegister reg) { Assign(0, reg); });
+        Visit(snapshot, header.cx_registers, header.num_cx_registers, [&](ShaderRegister reg) { Assign(1, reg); });
