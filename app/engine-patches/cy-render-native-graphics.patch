+void residentSnapshotTests(const Device& device) {
+    using namespace AgcDriver::GuestMemory;
+    if (std::getenv("APS5_NO_RESIDENT_DRAW_SNAPSHOTS") != nullptr) return;
+    constexpr std::size_t bytes = 4 * 65536;
+    Recorder recorder(device.GetContext());
+    const auto makeSource = [&](std::byte value) {
+        auto source = std::make_shared<Buffer>(device.GetContext(), bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+        std::fill(source->Bytes().begin(), source->Bytes().end(), value);
+        return source;
+    };
+    auto source = makeSource(std::byte{0x31});
+    for (std::size_t index = 0; index < 4; ++index) std::memset(source->Bytes().data() + index * 65536, static_cast<int>(0x31 + index), 65536);
+    constexpr std::uint64_t address = 0x600000000;
+    const auto registry = GuestAllocations::GuestAllocationsGeneration_nid_postfix();
+    recorder.KeepDrawSnapshot(address, bytes, 1, registry, source);
+    const auto resident = recorder.ResidentDrawSnapshot(source);
+    Require(resident != nullptr && recorder.ResidentDrawSnapshot(source) == resident, "resident snapshot upload was not reused");
+    const auto read = [&](const std::shared_ptr<DeviceBuffer>& buffer, VkDeviceSize offset, std::byte expected) {
+        Buffer readback(device.GetContext(), 65536, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+        const auto commands = recorder.Commands();
+        RecordMemoryBarrier(device.GetContext(), commands, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+        CopyBuffer(device.GetContext(), commands, buffer->Handle(), offset, readback.Handle(), 0, 65536);
+        RecordMemoryBarrier(device.GetContext(), commands, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+        recorder.Sync();
+        readback.Invalidate();
+        Require(std::all_of(readback.Bytes().begin(), readback.Bytes().end(), [&](std::byte value) { return value == expected; }), "resident GPU snapshot values differ");
+    };
+    read(resident, 2 * 65536, std::byte{0x33});
+    const auto unsupported = std::make_shared<Buffer>(device.GetContext(), bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    recorder.KeepDrawSnapshot(address + bytes, bytes, 1, registry, unsupported);
+    Require(recorder.ResidentDrawSnapshot(unsupported) == nullptr, "resident upload used a buffer without transfer-source support");
+    const auto odd = std::make_shared<Buffer>(device.GetContext(), 65537, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+    recorder.KeepDrawSnapshot(address + bytes + 65536, 65537, 1, registry, odd);
+    Require(recorder.ResidentDrawSnapshot(odd) == nullptr, "unaligned resident copy was recorded");
+    const auto untracked = makeSource(std::byte{0});
+    Require(recorder.ResidentDrawSnapshot(untracked) == nullptr, "resident upload accepted an unregistered transient buffer");
+    for (std::size_t index = 0; index < Recorder::DrawResidentEntries; ++index) {
+        auto entry = makeSource(std::byte{0x55});
+        recorder.KeepDrawSnapshot(address + (index + 2) * bytes, bytes, 1, registry, entry);
+        Require(recorder.ResidentDrawSnapshot(entry) != nullptr, "resident snapshot entry was not created");
+    }
+    const auto reloaded = recorder.ResidentDrawSnapshot(source);
+    Require(reloaded != nullptr && reloaded != resident, "resident entry limit did not evict the least recent upload");
+    read(resident, 2 * 65536, std::byte{0x33});
+    read(reloaded, 65536, std::byte{0x32});
+    const auto replacement = makeSource(std::byte{0x77});
+    recorder.KeepDrawSnapshot(address, bytes, 1, registry, replacement);
+    Require(recorder.ResidentDrawSnapshot(source) == nullptr, "replaced snapshot retained its resident source index");
+    const auto replaced = recorder.ResidentDrawSnapshot(replacement);
+    Require(replaced != nullptr && replaced != reloaded, "replacement snapshot reused the old GPU data");
+    read(replaced, 0, std::byte{0x77});
+    if (WriteWatched()) {
+        void* watched = AllocateWatched(bytes, 65536);
+        Require(watched != nullptr, "resident snapshot write-watch allocation failed");
+        struct Release {
+            void* block;
+            ~Release() { ReleaseWatched(block, bytes); }
+        } release{watched};
+        std::memset(watched, 0x44, bytes);
+        const auto guest = reinterpret_cast<std::uint64_t>(watched);
+        BumpCollectEpoch();
+        const auto generation = CollectWrites(guest, bytes);
+        auto captured = makeSource(std::byte{0x44});
+        Recorder changed(device.GetContext());
+        changed.KeepDrawSnapshot(guest, bytes, generation, registry, captured);
+        const auto held = changed.ResidentDrawSnapshot(captured);
+        captured.reset();
+        changed.Sync();
+        changed.FlushDeferredReleases();
+        std::memset(watched, 0x88, bytes);
+        BumpCollectEpoch();
+        Require(changed.ReusableDrawSnapshot(guest, bytes, Recorder::SnapshotUse::Storage, nullptr, CollectWrites(guest, bytes)) == nullptr, "resident source was modified in place after a CPU write");
+        read(held, 0, std::byte{0x44});
+    }
+    std::cout << "native resident snapshot GPU values and eviction passed\n";
+}
