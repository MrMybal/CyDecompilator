+void persistentSnapshotSliceTests(const Device& device) {
+    using namespace AgcDriver::GuestMemory;
+    if (std::getenv("APS5_NO_PERSISTENT_DRAW_SLICES") != nullptr) return;
+    constexpr std::size_t bytes = 4 * 65536;
+    void* block = WriteWatched() ? AllocateWatched(bytes, 65536) : nullptr;
+    if (block == nullptr) {
+        std::cout << "write watching unavailable: persistent snapshot slices not tested\n";
+        return;
+    }
+    struct Release {
+        void* block;
+        ~Release() { ReleaseWatched(block, bytes); }
+    } release{block};
+    const auto address = reinterpret_cast<std::uint64_t>(block);
+    const auto alignment = std::max<VkDeviceSize>(device.GetContext().limits.minStorageBufferOffsetAlignment, 1);
+    Require(alignment < 65536, "slice fixture alignment exceeds a tracked block");
+    for (std::size_t index = 0; index < 4; ++index) std::memset(static_cast<std::byte*>(block) + index * 65536, static_cast<int>(0x31 + index), 65536);
+    auto captured = std::make_shared<Buffer>(device.GetContext(), bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+    std::memcpy(captured->Bytes().data(), block, bytes);
+    const std::vector<std::byte> original(captured->Bytes().begin(), captured->Bytes().end());
+    Recorder cache(device.GetContext());
+    const auto registry = GuestAllocations::GuestAllocationsGeneration_nid_postfix();
+    const auto initial = CollectWrites(address, bytes);
+    Require(initial != 0, "persistent slice fixture has no generation");
+    cache.KeepDrawSnapshot(address, bytes, initial, registry, captured);
+    VkDeviceSize offset = 0;
+    BumpCollectEpoch();
+    Require(cache.ReusableDrawSnapshotSlice(address + 65536, 65536, CollectWrites(address + 65536, 65536), offset) == captured && offset == 65536, "an unchanged slice was copied after an epoch change");
+    Require(cache.ReusableDrawSnapshotSlice(address, 65536, CollectWrites(address, 65536), offset) == captured && offset == 0, "a shorter snapshot at the same base was not shared");
+    std::memset(block, 0x52, 4096);
+    BumpCollectEpoch();
+    Require(cache.ReusableDrawSnapshotSlice(address + 8192, 8192, CollectWrites(address, 65536), offset) == captured && offset == 8192, "a write outside a slice on the same tracked block changed its answer");
+    Require(cache.ReusableDrawSnapshotSlice(address + 65536, 65536, CollectWrites(address, bytes), offset) == captured, "a write outside a requested slice invalidated its immutable bytes");
+    Require(cache.ReusableDrawSnapshotSlice(address, 65536, CollectWrites(address, 65536), offset) == nullptr, "checking a slice advanced the generation of an unchecked region");
+    std::memset(block, 0x31, 4096);
+    BumpCollectEpoch();
+    Require(cache.ReusableDrawSnapshotSlice(address, 65536, CollectWrites(address, 65536), offset) == captured, "equal bytes on a dirty page could not reuse their snapshot");
+    std::memset(static_cast<std::byte*>(block) + 65536, 0x73, 4096);
+    BumpCollectEpoch();
+    Require(cache.ReusableDrawSnapshotSlice(address + 65536, 65536, CollectWrites(address + 65536, 65536), offset) == nullptr, "a slice outlived a CPU write in its own range");
+    Require(std::equal(original.begin(), original.end(), captured->Bytes().begin()), "slice validation modified a buffer retained by earlier draws");
+    Require(cache.ReusableDrawSnapshotSlice(address + bytes - alignment, alignment * 2, initial, offset) == nullptr, "a slice crossed the captured range");
+    Require(cache.ReusableDrawSnapshotSlice(address + bytes, alignment, initial, offset) == nullptr, "a slice started after the captured range");
+    if (alignment > 1) Require(cache.ReusableDrawSnapshotSlice(address + 1, alignment, initial, offset) == nullptr, "a slice violated descriptor offset alignment");
+    Require(cache.ReusableDrawSnapshotSlice(address, 65536, 0, offset) == nullptr, "an untracked request reused a persistent slice");
+    Recorder stale(device.GetContext());
+    stale.KeepDrawSnapshot(address, bytes, initial, registry + 1, captured);
+    Require(stale.ReusableDrawSnapshotSlice(address, 65536, initial, offset) == nullptr, "a slice ignored its allocation registry generation");
+    Recorder evicted(device.GetContext());
+    evicted.KeepDrawSnapshot(address, bytes, initial, registry, captured);
+    for (std::size_t index = 0; index < Recorder::DrawSnapshotEntries; ++index) evicted.KeepDrawSnapshot(address + bytes + index * 16, 1, initial, registry, captured);
+    Require(evicted.ReusableDrawSnapshotSlice(address, 65536, initial, offset) == nullptr, "an evicted snapshot still served a slice");
+    auto source = cache.ReusableDrawSnapshotSlice(address + 2 * 65536, 65536, CollectWrites(address + 2 * 65536, 65536), offset);
+    Require(source == captured && offset == 2 * 65536, "GPU readback has no immutable source slice");
+    Buffer readback(device.GetContext(), 65536, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+    CommandBatch commands(device.GetContext());
+    RecordMemoryBarrier(device.GetContext(), commands.Handle(), VK_PIPELINE_STAGE_HOST_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_HOST_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    CopyBuffer(device.GetContext(), commands.Handle(), source->Handle(), offset, readback.Handle(), 0, 65536);
+    RecordMemoryBarrier(device.GetContext(), commands.Handle(), VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+    commands.SubmitAndWait();
+    readback.Invalidate();
+    Require(std::all_of(readback.Bytes().begin(), readback.Bytes().end(), [](std::byte value) { return value == std::byte{0x33}; }), "GPU readback did not read the selected immutable buffer slice");
+    std::cout << "persistent snapshot GPU readback values passed\n";
+    std::cout << "persistent snapshot slice coherency tests passed\n";
+}
