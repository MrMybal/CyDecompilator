+ShaderRecompiler::RecompileResult CompileVertex(AgcDriver::VulkanDevice& device, std::span<const Vertex> vertices) {
+    const auto descriptor = DepthFastClearHarness::BufferDescriptor(vertices.data(), 16u, static_cast<std::uint32_t>(vertices.size()));
+    const std::array<ShaderRecompiler::MemoryRegion, 1> memory{{{reinterpret_cast<std::uintptr_t>(DepthFastClearHarness::VertexCode.data()), std::as_bytes(std::span(DepthFastClearHarness::VertexCode))}}};
+    ShaderRecompiler::RecompileRequest request{
+        {ShaderStage::Vertex, reinterpret_cast<std::uintptr_t>(DepthFastClearHarness::VertexCode.data()), DepthFastClearHarness::VertexCode, 0, {}},
+        {32, 0, descriptor, std::nullopt, std::nullopt, ShaderRecompiler::ShaderVertexStageInfo{}, memory},
+        device.Target(), {0, 0, 0, 64}
+    };
+    request.useCache = false;
+    return ShaderRecompiler::Recompile(request);
+}
+
+AgcDriver::Graphics::State State(float* color) {
+    AgcDriver::Graphics::State state{};
+    state.stages = {AgcDriver::Graphics::ShaderPath::Vertex, 0u, 32u, 32u, std::nullopt, std::nullopt};
+    state.color = {reinterpret_cast<std::uintptr_t>(color), {Width, Height}, VK_FORMAT_R32_SFLOAT, Width * Height * 4u, 0xe4u};
+    state.colors = {state.color};
+    state.hasColorTarget = true;
+    state.renderExtent = {Width, Height};
+    state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    state.viewport = {0, static_cast<float>(Height), static_cast<float>(Width), -static_cast<float>(Height), 0, 1};
+    state.scissor = {{0, 0}, {Width, Height}};
+    state.cullMode = VK_CULL_MODE_NONE;
+    state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    state.blend.colorWriteMask = VK_COLOR_COMPONENT_R_BIT;
+    state.blends = {state.blend};
+    return state;
+}
+
+void Draw(AgcDriver::VulkanDevice& device, const AgcDriver::Graphics::State& state, std::span<const Vertex> vertices, const ShaderRecompiler::RecompileResult& pixel, bool rectangle = false) {
+    auto vertex = CompileVertex(device, vertices);
+    std::vector<AgcDriver::Graphics::CompiledShader> stages{
+        {ShaderStage::Vertex, &vertex, 0},
+        {ShaderStage::Fragment, &pixel, pixel.pushConstants.empty() ? 0u : PixelPushOffset(static_cast<std::uint32_t>(vertex.pushConstants.size()), device.Target())}
+    };
+    std::optional<ShaderRecompiler::RectListShaders> rect;
+    if (rectangle) {
+        rect = ShaderRecompiler::BuildRectListShaders(vertex, pixel, device.Target());
+        stages.insert(stages.begin() + 1, {{ShaderStage::TessellationControl, &rect->control, 0}, {ShaderStage::TessellationEvaluation, &rect->evaluation, 0}});
+    }
+    const AgcDriver::Pm4::DrawParameters draw{0, static_cast<std::uint32_t>(vertices.size()), 0, 1, 0, false};
+    device.Draw(state, draw, stages);
+    device.WaitIdle();
+}
