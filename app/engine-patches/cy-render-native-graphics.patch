+ShaderRecompiler::RecompileResult DepthCopyFragment(const DepthTarget& source) {
+    Require(source.samples == 1u && source.firstSlice == source.lastSlice, "depth copy fragment requires one sample and one slice");
+    Require(source.address != 0u && (source.address & 255u) == 0u, "depth copy source is null or not aligned");
+    const bool d16 = source.format == VK_FORMAT_D16_UNORM || source.format == VK_FORMAT_D16_UNORM_S8_UINT;
+    Require(d16 || source.format == VK_FORMAT_D32_SFLOAT || source.format == VK_FORMAT_D32_SFLOAT_S8_UINT, "depth copy source format is unsupported");
+    const auto width = source.extent.width - 1u;
+    const auto height = source.extent.height - 1u;
+    const auto address = source.address >> 8u;
+    ShaderRecompiler::DescriptorBinding binding{};
+    binding.kind = ShaderRecompiler::DescriptorKind::SampledImage;
+    binding.role = ShaderRecompiler::DescriptorRole::GuestImages;
+    binding.descriptorSet = ShaderRecompiler::RuntimeAbi::FragmentDescriptorSet;
+    binding.binding = ShaderRecompiler::RuntimeAbi::BindingNumber(ShaderRecompiler::RuntimeAbi::Stage::Fragment, static_cast<ShaderRecompiler::RuntimeAbi::Binding>(ShaderRecompiler::RuntimeAbi::FirstImageBinding));
+    binding.count = 1u;
+    binding.readOnly = true;
+    binding.imageSamplers = {0u};
+    binding.imageDepthCompare = {false};
+    binding.imageShape = ShaderRecompiler::DescriptorImageShape::Image2D;
+    binding.guestDescriptor = {
+        static_cast<std::uint32_t>(address),
+        static_cast<std::uint32_t>(address >> 32u) | ((d16 ? 7u : 22u) << 20u) | ((width & 3u) << 30u),
+        (width >> 2u) | (height << 14u),
+        0x90000facu | (source.depthSwizzle << 20u), 0u, 0u, 0u, 0u
+    };
+    ShaderRecompiler::RecompileResult result{};
+    result.spirv = std::vector<std::uint32_t>(std::begin(DEPTH_COPY_SPV), std::end(DEPTH_COPY_SPV));
+    result.bindings.push_back(std::move(binding));
+    return result;
+}
+
+}
