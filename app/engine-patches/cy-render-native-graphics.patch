+void SharedReadSnapshots() {
+    ShaderSnapshot shader{};
+    shader.prepared->registeredAbis = {{11, 22}, {33, 44}};
+    std::shared_ptr<const PreparedShaderState> published;
+    {
+        ShaderPreparationTransaction transaction;
+        const auto& read = transaction.Read(shader);
+        published = shader.prepared->publishedState;
+        Require(published != nullptr && &read == published.get(), "a read did not retain the published preparation state");
+        transaction.Commit();
+    }
+    {
+        ShaderPreparationTransaction transaction;
+        Require(&transaction.Read(shader) == published.get(), "an unchanged preparation state was copied for another transaction");
+        transaction.Edit(shader).registeredAbis.push_back({55, 66});
+        {
+            ShaderPreparationTransaction nested;
+            Require(nested.Read(shader).registeredAbis.size() == 3, "a nested read missed the transaction's staged update");
+            nested.Commit();
+        }
+        Require(published->registeredAbis.size() == 2 && shader.prepared->registeredAbis.size() == 2, "a staged write changed a published preparation state");
+    }
+    {
+        ShaderPreparationTransaction transaction;
+        Require(&transaction.Read(shader) == published.get() && transaction.Read(shader).registeredAbis.size() == 2, "aborting a writer changed the shared preparation state");
+        transaction.Edit(shader).registeredAbis.push_back({77, 88});
+        transaction.Commit();
+    }
+    {
+        ShaderPreparationTransaction transaction;
+        const auto& read = transaction.Read(shader);
+        Require(&read != published.get() && read.registeredAbis.size() == 3 && read.registeredAbis.back() == std::vector<std::uint64_t>({77, 88}), "a committed update reused a stale published preparation state");
+        Require(published->registeredAbis.size() == 2, "a writer changed a retained reader snapshot");
+        transaction.Commit();
+    }
+}
+
+void ConcurrentReadSnapshots() {
+    ShaderSnapshot front{};
+    ShaderSnapshot pixel{};
+    front.prepared->entries.push_back({1, {}});
+    pixel.prepared->entries.push_back({2, {}});
+    std::shared_ptr<const PreparedShaderState> retained;
+    std::future<bool> concurrentReader;
+    {
+        ShaderPreparationTransaction transaction;
+        retained = transaction.ReadOnly(front);
+        Require(retained != nullptr && retained->entries.size() == 1, "read-only preparation is unavailable");
+        concurrentReader = std::async(std::launch::async, [&] {
+            ShaderPreparationTransaction other;
+            const auto read = other.ReadOnly(front);
+            const bool same = read == retained;
+            other.Commit();
+            return same;
+        });
+        Require(concurrentReader.wait_for(std::chrono::seconds(2)) == std::future_status::ready && concurrentReader.get(), "independent read-only transactions serialized or copied their state");
+        transaction.Edit(front).registeredAbis.push_back({123});
+        Require(transaction.ReadOnly(front) == nullptr, "read-only preparation ignored staged edits");
+        {
+            ShaderPreparationTransaction nested;
+            Require(nested.ReadOnly(front) == nullptr && nested.Read(front).registeredAbis.size() == 1, "nested preparation bypassed its writer");
+            nested.Commit();
+        }
+        transaction.Commit();
+    }
+    Require(retained->registeredAbis.empty() && front.prepared->registeredAbis.size() == 1, "read-to-write upgrade modified a retained reader");
+    std::future<void> writer;
+    {
