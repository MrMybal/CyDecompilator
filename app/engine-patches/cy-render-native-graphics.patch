+        producer.depth = AgcDriver::Graphics::DepthTarget{reinterpret_cast<std::uintptr_t>(Depth.data()), 0, {Width, Height}, VK_FORMAT_D32_SFLOAT, 1, 0};
+        producer.depthTest = true;
+        producer.depthWrite = true;
+        producer.depthCompare = VK_COMPARE_OP_ALWAYS;
+        Draw(*device, producer, Producer, producerShader.pixel);
+        const auto fragment = AgcDriver::Graphics::DepthCopyFragment(*producer.depth);
+        for (std::uint32_t test = 0; test < 7u; ++test) {
+            constexpr float Sentinel = -7.25f;
+            Copied.fill(Sentinel);
+            auto state = State(Copied.data());
+            if (test == 2u || test == 6u) state.scissor = {{8, 5}, {32, 18}};
+            if (test == 4u) state.cullMode = VK_CULL_MODE_FRONT_AND_BACK;
+            const std::span<const Vertex> vertices = test == 1u || test == 2u ? std::span<const Vertex>(Half) : test == 3u ? std::span<const Vertex>(Triangle) : std::span<const Vertex>(Full);
+            if (test >= 5u) {
+                state.rectList = true;
+                state.topology = VK_PRIMITIVE_TOPOLOGY_PATCH_LIST;
+            }
+            Draw(*device, state, test >= 5u ? std::span<const Vertex>(Half).first(3) : vertices, fragment, test >= 5u);
+            for (std::uint32_t y = 0; y < Height; ++y) {
+                for (std::uint32_t x = 0; x < Width; ++x) {
+                    bool covered = test == 0u || ((test <= 2u || test >= 5u) && x < Width / 2u) || (test == 3u && (x + 0.5f) / Width + (y + 0.5f) / Height < 1.0f);
+                    if (test == 2u || test == 6u) covered = covered && x >= 8u && x < 40u && y >= 5u && y < 23u;
+                    const float expected = covered ? 0.25f + 0.5f * (x + 0.5f) / Width : Sentinel;
+                    const auto actual = Copied[y * Width + x];
+                    if (std::abs(actual - expected) > 0.00001f) {
+                        char text[256];
+                        std::snprintf(text, sizeof(text), "depth copy case %u pixel (%u,%u): got %.9g, expected %.9g", test, x, y, actual, expected);
+                        throw std::runtime_error(text);
+                    }
+                }
+            }
+        }
+        std::puts("Depth copy GPU values, geometry, scissor and culling passed: 14336 pixels checked");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
