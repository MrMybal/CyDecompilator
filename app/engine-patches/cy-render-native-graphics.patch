+    template<typename TValue, typename TVisit>
+    static void Visit(const ShaderSnapshot& snapshot, const TValue* pointer, std::size_t count, TVisit&& visit) {
+        if (count == 0) return;
+        const auto address = reinterpret_cast<std::uintptr_t>(pointer);
+        require(address >= snapshot.headerAddress && address - snapshot.headerAddress <= snapshot.header.size(), "shader metadata is outside the registered header");
+        const auto offset = static_cast<std::size_t>(address - snapshot.headerAddress);
+        require(count <= (snapshot.header.size() - offset) / sizeof(TValue), "truncated shader metadata");
+        for (std::size_t index = 0; index < count; ++index) {
+            TValue value;
+            std::memcpy(&value, snapshot.header.data() + offset + index * sizeof(TValue), sizeof(TValue));
+            visit(value);
+        }
+    }
+
